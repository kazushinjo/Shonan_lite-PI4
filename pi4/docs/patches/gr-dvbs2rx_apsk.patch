new file mode 100644
index 0000000..da287dc
--- /dev/null
+++ b/lib/qa_apsk.cc
@@ -0,0 +1,97 @@
+/* -*- c++ -*- */
+/*
+ * Copyright 2026 Kazu Shinjo.
+ *
+ * This file is part of gr-dvbs2rx.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "apsk.hh"
+#include <boost/test/unit_test.hpp>
+#include <random>
+
+namespace gr {
+namespace dvbs2rx {
+
+typedef AmplitudePhaseShiftKeying<gr_complex, int8_t> Apsk;
+
+static const std::vector<std::pair<dvb_constellation_t, dvb_code_rate_t>> all_modcods = {
+    { MOD_16APSK, C2_3 }, { MOD_16APSK, C3_4 }, { MOD_16APSK, C4_5 },
+    { MOD_16APSK, C5_6 }, { MOD_16APSK, C8_9 }, { MOD_16APSK, C9_10 },
+    { MOD_32APSK, C3_4 }, { MOD_32APSK, C4_5 }, { MOD_32APSK, C5_6 },
+    { MOD_32APSK, C8_9 }, { MOD_32APSK, C9_10 }
+};
+
+BOOST_AUTO_TEST_CASE(test_apsk_unit_energy)
+{
+    for (const auto& mc : all_modcods) {
+        Apsk apsk(mc.first, mc.second);
+        float e = 0;
+        for (const auto& p : apsk.points())
+            e += std::norm(p);
+        BOOST_CHECK_CLOSE(e / apsk.points().size(), 1.0, 1e-3);
+    }
+}
+
+BOOST_AUTO_TEST_CASE(test_apsk_16_points)
+{
+    // ETSI EN 302 307-1 Figure 13: label 0000 on the outer ring at pi/4 and label 1100
+    // on the inner ring at pi/4 (rate 2/3, gamma = 3.15)
+    Apsk apsk(MOD_16APSK, C2_3);
+    const auto& p = apsk.points();
+    BOOST_CHECK_CLOSE(std::arg(p[0]), M_PI / 4, 1e-3);
+    BOOST_CHECK_CLOSE(std::arg(p[12]), M_PI / 4, 1e-3);
+    BOOST_CHECK_CLOSE(std::abs(p[0]) / std::abs(p[12]), 3.15, 1e-3);
+}
+
+BOOST_AUTO_TEST_CASE(test_apsk_32_points)
+{
+    // ETSI EN 302 307-1 Figure 14 (rate 3/4: gamma1 = 2.84, gamma2 = 5.27)
+    Apsk apsk(MOD_32APSK, C3_4);
+    const auto& p = apsk.points();
+    BOOST_CHECK_CLOSE(std::abs(p[0]) / std::abs(p[17]), 2.84, 1e-3);
+    BOOST_CHECK_CLOSE(std::abs(p[24]) / std::abs(p[17]), 5.27, 1e-3);
+    BOOST_CHECK_SMALL(std::arg(p[24]), 1e-6f);
+}
+
+BOOST_AUTO_TEST_CASE(test_apsk_map_hard_roundtrip)
+{
+    for (const auto& mc : all_modcods) {
+        Apsk apsk(mc.first, mc.second);
+        const int n = apsk.bits();
+        int8_t b[5], b2[5];
+        for (int idx = 0; idx < (1 << n); idx++) {
+            for (int k = 0; k < n; k++)
+                b[k] = ((idx >> (n - 1 - k)) & 1) ? -1 : 1;
+            gr_complex s = apsk.map(b);
+            BOOST_CHECK_EQUAL(s, apsk.points()[idx]);
+            apsk.hard(b2, s);
+            BOOST_CHECK_EQUAL_COLLECTIONS(b, b + n, b2, b2 + n);
+        }
+    }
+}
+
+BOOST_AUTO_TEST_CASE(test_apsk_soft_sign)
+{
+    // With moderate noise, the soft decisions must match the transmitted bits in sign
+    std::mt19937 gen(1234);
+    std::normal_distribution<float> noise(0, 0.02);
+    for (const auto& mc : all_modcods) {
+        Apsk apsk(mc.first, mc.second);
+        const int n = apsk.bits();
+        const float N0 = 2 * 0.02 * 0.02;
+        int8_t b[5], soft[5];
+        for (int idx = 0; idx < (1 << n); idx++) {
+            for (int k = 0; k < n; k++)
+                b[k] = ((idx >> (n - 1 - k)) & 1) ? -1 : 1;
+            gr_complex y = apsk.map(b) + gr_complex(noise(gen), noise(gen));
+            apsk.soft(soft, y, 4.0 / N0);
+            for (int k = 0; k < n; k++)
+                BOOST_CHECK(soft[k] * b[k] > 0);
+        }
+    }
+}
+
+} // namespace dvbs2rx
+} // namespace gr
