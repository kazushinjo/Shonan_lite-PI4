+
+float xfecframe_demapper_cb_impl::apsk_normalize(const gr_complex* in)
+{
+    // Unlike PSK, the APSK decision regions depend on the symbol amplitude, which is
+    // not normalized upstream (the AGC acts on the raw samples). Estimate the gain
+    // decision-directed over a subset of the XFECFRAME, starting from the total power,
+    // then scale the frame to the unit average energy of the transmitted constellation.
+    static constexpr unsigned int step = 8;
+    const auto& points = d_apsk->points();
+    float p = 0;
+    unsigned int n = 0;
+    for (unsigned int j = 0; j < d_xfecframe_len; j += step, n++)
+        p += std::norm(in[j]);
+    float g = std::sqrt(p / n);
+    for (int it = 0; it < 2 && g > 0; it++) {
+        float num = 0;
+        float den = 0;
+        for (unsigned int j = 0; j < d_xfecframe_len; j += step) {
+            const gr_complex& s = points[d_apsk->nearest(in[j] / g)];
+            num += std::real(in[j] * std::conj(s));
+            den += std::norm(s);
+        }
+        g = num / den;
+    }
+    if (!(g > 0))
+        g = 1;
+
+    // Normalize and measure the decision-directed noise energy
+    float np = 0;
+    for (unsigned int j = 0; j < d_xfecframe_len; j++) {
+        d_apsk_buffer[j] = in[j] / g;
+        np += std::norm(d_apsk_buffer[j] - points[d_apsk->nearest(d_apsk_buffer[j])]);
+    }
+    np /= d_xfecframe_len;
+    if (!(np > 0))
+        np = 1e-12;
+    return 1.0 / np; // linear SNR (unit symbol energy)
+}
 
