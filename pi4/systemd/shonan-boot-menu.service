[Unit]
Description=Shonan/Langstone Boot Menu
After=multi-user.target
Conflicts=shonan-gui.service langstone.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Shonan_Lite-pi4/pi4/gui
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_HIDECURSOR=1
ExecStartPre=+/bin/sh -c 'if [ -e /sys/class/graphics/fb0/blank ]; then echo 0 > /sys/class/graphics/fb0/blank; fi'
ExecStart=/usr/bin/python3 /home/pi/Shonan_Lite-pi4/pi4/gui/boot_menu.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
