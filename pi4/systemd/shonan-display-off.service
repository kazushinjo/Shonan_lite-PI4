[Unit]
Description=Blank Shonan DSI display during shutdown
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh /home/pi/Shonan_Lite-pi4/pi4/scripts/lcd_wake.sh
ExecStop=/bin/sh /home/pi/Shonan_Lite-pi4/pi4/scripts/lcd_off.sh
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
