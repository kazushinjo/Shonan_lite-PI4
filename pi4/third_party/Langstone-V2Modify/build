#!/usr/bin/env bash
set -e
LIBIIO_SO="${LIBIIO_SO:-/usr/lib/aarch64-linux-gnu/libiio.so.0.25}"
# With -I/usr/include/iio, <iio.h> resolves to /usr/include/iio/iio.h when present.
IIO_HEADER=/usr/include/iio/iio.h
[ -f "$IIO_HEADER" ] || IIO_HEADER=/usr/include/iio.h
IIO_DECL_FLAGS=""
if ! grep -q 'iio_channel_attr_write_longlong' "$IIO_HEADER"; then
  IIO_DECL_FLAGS="-DLANGSTONE_DECLARE_LEGACY_IIO"
fi
cc $IIO_DECL_FLAGS -I/home/pi/Langstone -I/usr/include/iio -I/usr/include/freetype2 -I/home/pi/LimeSuite/src -I/home/pi/LimeSuite/src/lime /home/pi/Langstone/LangstoneGUI_Pluto.c -o /home/pi/Langstone/GUI_Pluto "$LIBIIO_SO" -L/home/pi/WiringPi/wiringPi -L/usr/lib/aarch64-linux-gnu -lLimeSuite -lwiringPi -lm -lfreetype
cc /home/pi/Langstone/HW_Test.c -o /home/pi/Langstone/HW_Test -lwiringPi
cc /home/pi/Langstone/Pluto_Test.c -o /home/pi/Langstone/Pluto_Test -liio
