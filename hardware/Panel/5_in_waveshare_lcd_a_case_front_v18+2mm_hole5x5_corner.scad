// 5インチ Waveshare LCD ケース前面 v18+2mm ボス4隅版
// 元のSTLを polyhedron として埋め込み、ボスと穴を下のパラメータで作り直す
// ボスは内側の4隅(縦横の壁に接する位置)に置く。穴ピッチは結果として決まる(コンソールに表示)

/* [取り付け穴] */
hole_d     = 5;      // 穴径
hole_depth = 5;      // 穴深さ (上面 Z=8 から)
boss_d     = 6.62;   // ボス外径 (元と同じ)
wall_gap   = 0;      // 壁とボスのすき間 (0 で壁に接する)

/* [固定値: 元形状] */
top_z    = 8;        // ボス上面
base_z   = 1.5;      // 板の上面 (ボスの根元)
inner_x  = [-59.27, 62.0];   // 内壁の X
inner_y  = [-45.17, 49.17];  // 内壁の Y
old_pos  = [[58.69,45.85],[58.69,-37.77],[-55.96,45.85],[-55.96,-37.77]];
old_boss_d = 6.62;
old_rib_y  = [-41.1, -34.44];             // 下側ボスと横壁をつなぐ旧リブ
old_rib_x  = [[-59.27,-55.96],[58.69,62.0]];
$fn = 72;
function mean(v) = (v[0]+v[1])/2;

off = boss_d/2 + wall_gap;
new_pos = [for (x=[inner_x[1]-off, inner_x[0]+off], y=[inner_y[1]-off, inner_y[0]+off]) [x,y]];
echo(str("穴ピッチ = ", inner_x[1]-inner_x[0]-2*off, " x ", inner_y[1]-inner_y[0]-2*off));

difference() {
  union() {
    difference() {
      original();
      intersection() {   // 内壁より内側だけを削る(壁は削らない)
        translate([inner_x[0],inner_y[0],base_z]) cube([inner_x[1]-inner_x[0], inner_y[1]-inner_y[0], top_z-base_z+0.1]);
        union() {
          for (p=old_pos) translate([p[0],p[1],0]) cylinder(d=old_boss_d+0.1, h=top_z+0.1);   // 旧ボス
          for (rx=old_rib_x) translate([rx[0]-0.1,old_rib_y[0],0]) cube([rx[1]-rx[0]+0.2, old_rib_y[1]-old_rib_y[0], top_z+0.1]);  // 旧リブ
        }
      }
    }
    for (p=new_pos) translate([p[0],p[1],base_z-0.1]) {
      cylinder(d=boss_d, h=top_z-base_z+0.1);                                                        // 新ボス
      if (wall_gap == 0)   // 隅側は四角く埋めて壁と一体にする
        for (sx=[sign(p[0]-mean(inner_x))], sy=[sign(p[1]-mean(inner_y))])
          translate([sx<0 ? -off-0.05 : 0, sy<0 ? -off-0.05 : 0, 0]) cube([off+0.05, off+0.05, top_z-base_z+0.1]);
    }
  }
  for (p=new_pos) translate([p[0],p[1],top_z-hole_depth]) cylinder(d=hole_d, h=hole_depth+0.1);        // 穴
}

